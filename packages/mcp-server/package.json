{
  "name": "@peekit/cli",
  "version": "0.1.0-alpha.0",
  "description": "Peekit MCP server. Runtime eyes for AI agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzk-gh/peekit.git",
    "directory": "packages/mcp-server"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/.tsbuildinfo", "README.md"],
  "bin": {
    "peekit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@peekit/adapter-h5": "workspace:*",
    "@peekit/adapter-mp-weixin": "workspace:*",
    "@peekit/core": "workspace:*",
    "@peekit/reporter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
