{
  "name": "@peekit/reporter",
  "version": "0.1.0-alpha.0",
  "description": "Agent-readable JSON and Markdown evidence summaries for Peekit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzk-gh/peekit.git",
    "directory": "packages/reporter"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/.tsbuildinfo"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@peekit/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
