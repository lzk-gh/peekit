{
  "name": "@peekit/adapter-h5",
  "version": "0.1.0",
  "description": "Playwright-powered H5 runtime adapter for Peekit.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
